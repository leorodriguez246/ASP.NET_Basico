@model GameVault.Models.Videojuego

@{
    ViewData["Title"] = "Registrar juego";
}


<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 fw-bold">Registrar nuevo Videojuego</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Juego" asp-action="Crear" method="POST">
                       <div class="mb-3">
                           <label asp-for="Titulo" class="form-label fw-bold">Titulo</label>
                            <input asp-for="Titulo" class="form-control" placeholder="Ingrese titulo aqui" />
                            <span asp-validation-for="Titulo" class="text-danger small"></span>
                       </div>
                       <div class="mb-3">
                            <label asp-for="Genero" class="form-label fw-bold">Genero</label>
                            <input asp-for="Genero" class="form-control" placeholder="Ingrese genero aqui" />
                            <span asp-validation-for="Genero" class="text-danger small"></span>
                       </div>     
                       <div class="mb-3">
                           <label asp-for="Plataforma" class="form-label fw-bold">Plataforma</label>
                            <select asp-for="Plataforma" class="form-select">
                                <option value="">Seleccione una opcion</option>
                                <option value="PC"> Steam / Epic Store</option>
                                <option value="PlayStation"> PlayStation</option>
                                <option value="Xbox"> XBOX</option>
                                <option value="Nintendo Switch"> Nintendo Switch</option>
                                <option value="Android/IOS"> Android / IOS</option>
                            </select>
                            <span asp-validation-for="Plataforma" class="text-danger small"></span>
                       </div>
                       <div class="row">
                           <div class="col-md-6 mb-3">
                               <label  asp-for="Precio" class="form-label fw-bold">Precio</label>
                               <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="Precio" type="number" step="any" class="form-control" placeholder="Ingrese Precio aqui" />
                               </div>
                                <span asp-validation-for="Precio" class="text-danger small"></span>
                          </div>
                          <div class="col-md-6 mb-3">
                                <label asp-for="AnioLanzamiento" class="form-label fw-bold">Año de lanzamiento</label>
                                <input asp-for="AnioLanzamiento" type="number" step="any" class="form-control" placeholder="Ingrese Año aqui" />
                                <span asp-validation-for="AnioLanzamiento" class="text-danger small"></span>
                          </div>
                       </div>     
                       <div class="d-flex justify-content-between mt-4">
                           <a asp-controller="Juego" asp-action="Index" class="btn btn-secondary">
                               Volver
                           </a>
                            <button type="submit" class="btn btn-success px-4">Guardar videojuego</button>
                       </div>   
                    </form>
                </div>    
            </div>
        </div>
    </div>
</div>