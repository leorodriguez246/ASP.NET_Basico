@model IEnumerable<GameVault.Models.Videojuego>

@{
    ViewData["Title"] = "Catalogo Videojuegos";
}


<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold text-primary">Listado de juegos disponibles</h1>
        <a asp-controller="Juego" asp-action="Crear" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> + Agregar Juego
        </a>
    </div>
    @if (!Model.Any())
    {
        <div class="alert alert-info text-center shadow-sm" role="alert">
            No hay Videojuegos registrados en el catalogo...
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Id</th>
                        <th>Titulo</th>
                        <th>Genero</th>
                        <th>Plataforma</th>
                        <th>Precio</th>
                        <th>Año</th>
                        <th class="text-center" style="width: 180px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var juego in Model)
                    {
                        <tr>
                            <td>@juego.Id</td>
                            <td class="fw-bold">@juego.Titulo</td>
                            <td><span class="badge bg-secondary">@juego.Genero</span></td>
                            <td>@juego.Plataforma</td>
                            <td>$@juego.Precio.ToString("N0")</td>
                            <td>@juego.AnioLanzamiento</td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a asp-controller="Juego" asp-action="Editar" asp-route-id="@juego.Id"
                                    class="btn btn-warning btn-sm">Editar</a>
                                    <a asp-controller="Juego" asp-action="Eliminar" asp-route-id="@juego.Id"
                                    class="btn btn-danger btn-sm" onclick="return confirm('¿Estas seguro de querer eliminar este juego: @juego.Titulo?')">Eliminar</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }



    
</div>